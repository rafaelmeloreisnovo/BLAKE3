{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelmeloreisnovo/BLAKE3/audit/schemas/blake3_forensic_event_v1.schema.json",
  "title": "BLAKE3 Forensic Event v1",
  "type": "object",
  "required": ["schema", "event_id", "observed_at", "source", "classification", "claim_allowed", "evidence", "custody"],
  "properties": {
    "schema": {"const": "rafaelia.blake3.forensic_event.v1"},
    "event_id": {"type": "string", "pattern": "^[A-Z0-9_-]{6,128}$"},
    "case_id": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["surface", "url"],
      "properties": {
        "surface": {"enum": ["git", "github_pr", "github_issue", "github_comment", "github_review", "github_actions", "release", "external", "local"]},
        "url": {"type": "string"},
        "repository": {"type": ["string", "null"]},
        "ref": {"type": ["string", "null"]},
        "sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "parents": {"type": "array", "items": {"type": "string"}},
        "tree": {"type": ["string", "null"]},
        "author_date": {"type": ["string", "null"], "format": "date-time"},
        "committer_date": {"type": ["string", "null"], "format": "date-time"},
        "github_event_at": {"type": ["string", "null"], "format": "date-time"},
        "receipt_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    },
    "actors": {
      "type": "object",
      "properties": {
        "author": {"type": ["object", "null"]},
        "committer": {"type": ["object", "null"]},
        "pusher": {"type": ["object", "null"]},
        "reviewer": {"type": ["object", "null"]},
        "agent": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "classification": {"enum": ["PROVADO", "EVIDENCIADO", "HIPÓTESE", "REFUTADO", "TOKEN_VAZIO"]},
    "claim_allowed": {"type": "boolean", "default": false},
    "claim": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "locator"],
        "properties": {
          "kind": {"type": "string"},
          "locator": {"type": "string"},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "blake3": {"type": ["string", "null"]},
          "size": {"type": ["integer", "null"], "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "score", "reason"],
        "properties": {
          "dimension": {"enum": ["time", "graph", "identity", "fork", "conversation", "execution", "artifact", "evidence"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"}
        }
      }
    },
    "counterevidence": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "custody": {
      "type": "object",
      "required": ["collector", "command", "tool_versions"],
      "properties": {
        "collector": {"type": "string"},
        "command": {"type": "string"},
        "tool_versions": {"type": "object"},
        "environment": {"type": "object"},
        "raw_path": {"type": ["string", "null"]},
        "manifest_path": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
